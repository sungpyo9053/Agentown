{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ready": { "type": "boolean" },
    "clarifiedBrief": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "clarificationQuestions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]{1,60}$" },
          "field": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]{0,59}$" },
          "question": { "type": "string", "minLength": 1, "maxLength": 500 },
          "required": { "type": "boolean" }
        },
        "required": ["id", "field", "question", "required"]
      }
    },
    "assumptions": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    }
  },
  "required": ["ready", "clarifiedBrief", "clarificationQuestions", "assumptions"]
}
