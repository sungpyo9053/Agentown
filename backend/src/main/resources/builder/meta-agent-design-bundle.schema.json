{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "objective": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "trigger": { "type": "string", "minLength": 1, "maxLength": 300 },
        "inputs": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 300 }, "maxItems": 20 },
        "outputs": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 300 }, "maxItems": 20 },
        "steps": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 300 }, "minItems": 1, "maxItems": 20 },
        "decisions": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 300 }, "maxItems": 20 },
        "exceptions": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 300 }, "maxItems": 20 },
        "humanApprovalRequired": { "type": "boolean" }
      },
      "required": ["objective", "trigger", "inputs", "outputs", "steps", "decisions", "exceptions", "humanApprovalRequired"]
    },
    "clarificationQuestions": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]{1,60}$" },
          "field": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]{0,59}$" },
          "question": { "type": "string", "minLength": 1, "maxLength": 500 },
          "required": { "type": "boolean" }
        },
        "required": ["id", "field", "question", "required"]
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "capabilities": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 300 }, "minItems": 1, "maxItems": 20 },
        "integrations": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 200 }, "maxItems": 10 },
        "approvalPoints": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 300 }, "maxItems": 10 },
        "failurePolicy": { "type": "string", "minLength": 1, "maxLength": 500 },
        "graphPlan": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "entryNodeId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,59}$" },
            "nodes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,59}$" },
                  "nodeType": { "type": "string", "enum": ["manual.trigger", "schedule.trigger", "text.input", "news.search.mock", "knowledge.search.mock", "flight.search.mock", "github.issue.mock", "parallel.map.mock", "tool.unresolved", "data.csv.compare", "data.deduplicate", "data.normalize", "quality.check", "template.render", "workflow.end", "condition.branch", "ai.classify", "ai.generate", "human.approval", "slack.new_message.mock", "slack.reply.mock", "slack.send.mock", "email.send.mock", "notion.search.mock", "notion.read_page.mock", "notion.create_page"] },
                  "label": { "type": "string", "minLength": 1, "maxLength": 160 },
                  "config": {
                    "anyOf": [
                      { "type": "object", "additionalProperties": false, "properties": {} },
                      {
                        "type": "object", "additionalProperties": false,
                        "properties": { "expression": { "type": "string", "maxLength": 500 } },
                        "required": ["expression"]
                      },
                      {
                        "type": "object", "additionalProperties": false,
                        "properties": {
                          "categories": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 160 }, "maxItems": 20 },
                          "agentKey": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,59}$" }
                        },
                        "required": ["categories", "agentKey"]
                      },
                      {
                        "type": "object", "additionalProperties": false,
                        "properties": {
                          "instruction": { "type": "string", "maxLength": 1000 },
                          "agentKey": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,59}$" }
                        },
                        "required": ["instruction", "agentKey"]
                      },
                      {
                        "type": "object", "additionalProperties": false,
                        "properties": { "approver": { "type": "string", "maxLength": 160 } },
                        "required": ["approver"]
                      },
                      {
                        "type": "object", "additionalProperties": false,
                        "properties": { "database": { "type": "string", "maxLength": 300 } },
                        "required": ["database"]
                      },
                      {
                        "type": "object", "additionalProperties": false,
                        "properties": { "pageId": { "type": "string", "maxLength": 300 } },
                        "required": ["pageId"]
                      },
                      {
                        "type": "object", "additionalProperties": false,
                        "properties": {
                          "cron": { "type": "string", "maxLength": 100 },
                          "timezone": { "type": "string", "maxLength": 100 }
                        },
                        "required": ["cron", "timezone"]
                      },
                      {
                        "type": "object", "additionalProperties": false,
                        "properties": {
                          "source": { "type": "string", "maxLength": 200 },
                          "query": { "type": "string", "maxLength": 300 },
                          "lookbackHours": { "type": "number", "minimum": 1, "maximum": 168 }
                        },
                        "required": ["source", "query", "lookbackHours"]
                      },
                      {
                        "type": "object", "additionalProperties": false,
                        "properties": { "key": { "type": "string", "maxLength": 100 } },
                        "required": ["key"]
                      },
                      {
                        "type": "object", "additionalProperties": false,
                        "properties": {
                          "source": { "type": "string", "maxLength": 300 },
                          "queryField": { "type": "string", "maxLength": 100 },
                          "connectionStatus": { "type": "string", "enum": ["UNRESOLVED", "CONNECTED"] }
                        },
                        "required": ["source", "queryField", "connectionStatus"]
                      },
                      {
                        "type": "object", "additionalProperties": false,
                        "properties": {
                          "keyColumns": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 100 }, "minItems": 1, "maxItems": 20 },
                          "comparisonMode": { "type": "string", "enum": ["EXACT"] }
                        },
                        "required": ["keyColumns", "comparisonMode"]
                      },
                      {
                        "type": "object", "additionalProperties": false,
                        "properties": {
                          "channel": { "type": "string", "maxLength": 160 },
                          "rendererKey": { "type": "string", "maxLength": 160 }
                        },
                        "required": ["channel", "rendererKey"]
                      },
                      {
                        "type": "object", "additionalProperties": false,
                        "properties": {
                          "recipient": { "type": "string", "maxLength": 320 },
                          "rendererKey": { "type": "string", "maxLength": 160 },
                          "connectionStatus": { "type": "string", "enum": ["UNRESOLVED", "CONNECTED"] }
                        },
                        "required": ["recipient", "rendererKey", "connectionStatus"]
                      },
                      {
                        "type": "object", "additionalProperties": false,
                        "properties": { "channel": { "type": "string", "maxLength": 160 } },
                        "required": ["channel"]
                      },
                      {
                        "type": "object", "additionalProperties": false,
                        "properties": { "rendererKey": { "type": "string", "maxLength": 160 } },
                        "required": ["rendererKey"]
                      }
                    ]
                  }
                },
                "required": ["id", "nodeType", "label", "config"]
              }
            },
            "edges": {
              "type": "array",
              "maxItems": 40,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,59}$" },
                  "source": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,59}$" },
                  "target": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,59}$" },
                  "condition": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*=(true|false|[A-Za-z0-9_-]+)$", "maxLength": 100 },
                  "bindings": {
                    "type": "array", "minItems": 1, "maxItems": 20,
                    "items": {
                      "type": "object", "additionalProperties": false,
                      "properties": {
                        "sourceField": { "type": "string", "minLength": 1, "maxLength": 160 },
                        "targetField": { "type": "string", "minLength": 1, "maxLength": 160 }
                      },
                      "required": ["sourceField", "targetField"]
                    }
                  }
                },
                "required": ["id", "source", "target", "condition", "bindings"]
              }
            }
          },
          "required": ["entryNodeId", "nodes", "edges"]
        }
      },
      "required": ["name", "summary", "capabilities", "integrations", "approvalPoints", "failurePolicy", "graphPlan"]
    },
    "agentDefinitions": {
      "type": "array",
      "minItems": 0,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,59}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "role": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "inputSchema": { "$ref": "#/$defs/fields" },
          "outputSchema": { "$ref": "#/$defs/fields" },
          "behaviorRules": { "$ref": "#/$defs/rules" },
          "forbiddenRules": { "$ref": "#/$defs/rules" },
          "evidenceRequirements": { "$ref": "#/$defs/rules" }
        },
        "required": ["key", "name", "role", "inputSchema", "outputSchema", "behaviorRules", "forbiddenRules", "evidenceRequirements"]
      }
    },
    "guideDefinitions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,59}$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 160 },
          "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "fields": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "key": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]{0,59}$" },
                "label": { "type": "string", "minLength": 1, "maxLength": 160 },
                "type": { "type": "string", "enum": ["text", "select", "boolean", "secret"] },
                "required": { "type": "boolean" },
                "secret": { "type": "boolean" },
                "help": { "type": "string", "minLength": 1, "maxLength": 500 }
              },
              "required": ["key", "label", "type", "required", "secret", "help"]
            }
          }
        },
        "required": ["key", "title", "description", "fields"]
      }
    }
  },
  "required": ["requirement", "clarificationQuestions", "proposal", "agentDefinitions", "guideDefinitions"],
  "$defs": {
    "fields": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]{0,59}$" },
          "type": { "type": "string", "enum": ["string", "boolean", "number", "object", "array"] },
          "required": { "type": "boolean" },
          "description": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "required": ["name", "type", "required", "description"]
      }
    },
    "rules": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 500 },
      "minItems": 1,
      "maxItems": 20
    }
  }
}
