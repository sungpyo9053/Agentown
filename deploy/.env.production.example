DOMAIN=agentown.example.com
ALT_DOMAIN=www.agentown.example.com
POSTGRES_DB=agent_village
POSTGRES_USER=agent_village
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Generate with: openssl rand -base64 32
LLM_KEY_VERSION=v1
LLM_MASTER_KEYS=v1:replace-with-base64-encoded-32-byte-key

# Use stub only for a private pre-production smoke test. Public production uses webhook.
EMAIL_PROVIDER=webhook
EMAIL_WEBHOOK_URL=https://email-bridge.example.com/send
EMAIL_WEBHOOK_TOKEN=replace-with-provider-token
