DOMAIN=example.com
ALT_DOMAIN=agentown.example.com
POSTGRES_DB=agent_village
POSTGRES_USER=agent_village
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Generate with: openssl rand -base64 32
LLM_KEY_VERSION=v1
LLM_MASTER_KEYS=v1:replace-with-base64-encoded-32-byte-key

# Use stub only for a private pre-production smoke test. Public production uses webhook.
EMAIL_PROVIDER=webhook
EMAIL_WEBHOOK_URL=https://email-bridge.example.com/send
EMAIL_WEBHOOK_TOKEN=replace-with-provider-token

# Create one Slack App from deploy/slack-app-manifest.yml, then store secrets only here.
SLACK_CONNECTOR_ENABLED=false
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URI=https://example.com/api/connectors/slack/oauth/callback
SLACK_FRONTEND_RESULT_URL=https://example.com/settings/connections
SLACK_EVENT_REQUEST_URL=https://example.com/api/connectors/slack/events
SLACK_SCOPES=channels:history,chat:write
