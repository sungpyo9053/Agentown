{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "goal", "user_problem", "service_impact", "release_title_ko", "user_change_summary_ko", "reason_for_priority", "priority", "in_scope", "out_of_scope", "acceptance_criteria", "verification_required", "dependencies", "risks", "status", "iteration", "max_iterations", "evidence_paths", "commit_scope"],
  "properties": {
    "task_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,79}$" },
    "goal": { "type": "string", "minLength": 10 },
    "user_problem": { "type": "string", "minLength": 10 },
    "service_impact": { "type": "string", "minLength": 10 },
    "release_title_ko": { "type": "string", "minLength": 5, "maxLength": 300 },
    "user_change_summary_ko": { "type": "string", "minLength": 10, "maxLength": 500 },
    "reason_for_priority": { "type": "string", "minLength": 10 },
    "priority": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
    "in_scope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
    "out_of_scope": { "type": "array", "items": { "type": "string", "minLength": 3 } },
    "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["id", "text"], "properties": { "id": { "type": "string" }, "text": { "type": "string", "minLength": 5 } } } },
    "verification_required": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "risks": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
    "status": { "type": "string", "enum": ["DISCOVERED", "PLANNED", "IN_PROGRESS", "IMPLEMENTED", "VERIFYING", "APPROVED", "CHANGES_REQUESTED", "BLOCKED", "DEFERRED", "HUMAN_DECISION_REQUIRED"] },
    "iteration": { "type": "integer", "minimum": 1 },
    "max_iterations": { "type": "integer", "minimum": 1, "maximum": 3 },
    "evidence_paths": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "commit_scope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
