{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agentown Release Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["release_id", "application", "environment", "approved_commit_sha", "source_branch", "planner_task_id", "planner_decision", "verification_report", "artifact_identity", "migration_plan", "deployment_strategy", "smoke_tests", "rollback_plan", "requires_human_approval", "status", "created_at", "uncertain_outcome", "evidence_paths"],
  "properties": {
    "release_id": {"type": "string", "minLength": 1},
    "application": {"type": "string", "minLength": 1},
    "environment": {"enum": ["STAGING", "PRODUCTION", "FAKE"]},
    "approved_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_branch": {"type": "string", "minLength": 1},
    "planner_task_id": {"type": "string", "minLength": 1},
    "planner_decision": {"enum": ["APPROVED", "CHANGES_REQUESTED", "BLOCKED", "HUMAN_DECISION_REQUIRED"]},
    "verification_report": {"type": "string", "minLength": 1},
    "artifact_identity": {"type": "object"},
    "migration_plan": {"type": "object"},
    "deployment_strategy": {"type": "object"},
    "smoke_tests": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "rollback_plan": {"type": "object"},
    "requires_human_approval": {"type": "boolean"},
    "approved_by": {"type": ["string", "null"]},
    "approved_at": {"type": ["string", "null"]},
    "scheduled_at": {"type": ["string", "null"]},
    "preflight_hash": {"type": ["string", "null"]},
    "approval_preflight_hash": {"type": ["string", "null"]},
    "status": {"enum": ["NOT_READY", "PREFLIGHT_CHECKING", "READY_FOR_STAGING", "STAGING_DEPLOYING", "STAGING_VERIFYING", "STAGING_FAILED", "RELEASE_APPROVAL_REQUIRED", "PRODUCTION_DEPLOYING", "PRODUCTION_VERIFYING", "PRODUCTION_FAILED", "ROLLBACK_REQUIRED", "ROLLING_BACK", "ROLLED_BACK", "RELEASED", "HUMAN_DECISION_REQUIRED", "FAILED_SAFE"]},
    "created_at": {"type": "string"},
    "started_at": {"type": ["string", "null"]},
    "completed_at": {"type": ["string", "null"]},
    "failure_reason": {"type": ["string", "null"]},
    "uncertain_outcome": {"type": "boolean"},
    "previous_release_sha": {"type": ["string", "null"]},
    "deployed_release_sha": {"type": ["string", "null"]},
    "evidence_paths": {"type": "array", "items": {"type": "string"}},
    "control_plane": {"type": "object"}
  }
}
