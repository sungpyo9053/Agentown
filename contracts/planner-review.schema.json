{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "summary",
    "criteria",
    "required_changes",
    "next_task",
    "human_decision"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["APPROVED", "CHANGES_REQUESTED", "BLOCKED", "HUMAN_DECISION_REQUIRED"]
    },
    "summary": { "type": "string" },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "status": { "type": "string", "enum": ["PASSED", "FAILED", "UNVERIFIED"] },
          "evidence": { "type": "string" }
        }
      }
    },
    "required_changes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "next_task": { "type": ["string", "null"] },
    "human_decision": { "type": ["string", "null"] }
  }
}
